// Invert, keeping hue and saturation or not, for logos supplied on white (or
// cream paper) that need to go on black or, with a transparent background,
// over moving visuals.
//
// Keeping hue and saturation: shifting all three channels by the same amount
// keeps a colour's hue and its chroma (max - min). Shifting by 1 - max - min
// turns its HSL lightness L = (max + min) / 2 into 1 - L, and since saturation
// depends on L only through |2L - 1|, saturation is kept too, and the result
// stays in 0..1. It is also linear for blends with white: a pixel that is a
// fraction a of colour F over white inverts to exactly a x invert(F) over
// black. So over black the inverted logo is exact; with a transparent
// background, what's left to find is each pixel's alpha.
//
// Passes (the C side runs them):
// 1. Copy: the source, so it can be read several times.
// 2. Paper (one pixel): the paper colour from 24 patches along the border, if
//    most of the border agrees on a light colour. Colours near it are moved to
//    white, so cream paper becomes background too.
// 3. Process: JPEG colour repair (JPEG keeps colour at half resolution; each
//    pixel's chroma is re-estimated from 5 x 5 neighbours of about the same
//    luma, and luma lightly smoothed the same way, which keeps the smear from
//    turning into dark bands once inverted), inversion (where two of the
//    logo's colours meet, of each of them, blended: see invert_blend) and
//    clean-up (faint
//    pixels with nothing brighter than the clean-up level around them become
//    black; faint pixels next to something brighter are edges and stay). With
//    a transparent background it also marks plateaus (flat 3 x 3; dark greys
//    also flat at radius 4, so a shadow's gentle slope isn't one) and the
//    largest one-pixel step around each pixel.
// 4. Alpha: alpha = brightness / G, where G is how bright the part the pixel
//    shows is at full strength:
//    - next to background (a near-black pixel within 2): G is the brightest
//      plateau of the same colour within 2, or on rings of radius 4 and 8; an
//      anti-aliased edge then blends into what's behind as it did into black,
//      and a solid part stays solid however dark;
//    - with no such plateau (a shadow, a glow, a blurred thin stroke): G is 1,
//      full strength, so it fades to transparent; unless the feature has crisp
//      sides (a sharp hairline) and is bright enough once inverted, then its
//      own brightest pixel (a pale hairline taken as solid would become an
//      opaque dark line over the visuals);
//    - where a solid part darker than (or about as dark as) the pixel is near
//      and no background is (a seam between two of the logo's colours), the
//      pixel stays solid; next to something soft (a shape over its own
//      shadow), alpha blends from that neighbour's.
//    The colour shown (premultiplied) never changes, so over black the result
//    is exactly the same as without transparency.
//
// Measured on a suite of synthetic logos with exact ideals (crisp, JPEG,
// blurred, cream paper, already transparent), against the earlier single-pass
// version: mean error over three backdrops 17.3 -> 12.1 (out of 255).
//
// Per-image controls, for what a pixel's surroundings can't tell but a person
// looking at the logo can (the defaults reproduce the automatic behaviour):
// - Background: the paper colour picked instead of read from the border (for a
//   logo that touches the edges, or an unusual paper).
// - JPEG clean-up: the black point. Above 8% it removes only specks: a pixel by
//   an area of 8 or more similar pixels is cleaned only as at 8%, so raising it
//   to clear JPEG noise doesn't eat pale parts of the logo.
// - Edge softness (reach): scales every distance the alpha pass looks, for
//   blurred or enlarged logos whose edges are wider than 2 pixels.
// - Thin lines and small text (detail): shifts the "crisp sides" test that
//   decides whether a feature with no plateau is at full strength.
// - Dark greys can be shadows: off skips the radius-4 slope test, so grey
//   plateaus count as solid parts.
//
// Limits: a part with no plateau and no crisp edge (a fine texture, grain)
// reads as soft and fades; "Fade shadows and glows" below 100% keeps more of
// it solid. Which pixels count as a plateau or a ring is measured in pixels,
// so very large images behave as if their shadows were sharper.

uniform float4x4 ViewProj;
uniform texture2d image;      // the input of the current pass
uniform texture2d paper_tex;  // 1 x 1: the paper colour (rgb) and whether to use it (a)

uniform float2 texel;         // 1 / the source's size in pixels
uniform float keep_hue;       // 1: keep hue and saturation, 0: plain inversion
uniform float black_point;    // 0..1: clean-up level (0: off)
uniform float fade;           // 0..1: how far shadows and glows fade
uniform float4 paper_pick;    // rgb: the background colour picked; a: 1 to use it, 0 automatic
uniform float reach;          // 1..4: how blurred the logo's edges are (scales how far the alpha pass looks)
uniform float detail;         // 0: thin features faint, 0.5: automatic, 1: solid
uniform float grey_shadows;   // 1: dark greys are judged as possible shadows, 0: as solid shapes

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

// ---------------------------------------------------------------- helpers --

// The colour at uv with straight alpha (the image arrives with premultiplied
// alpha). Rounding, or an image source applying alpha in linear light, can
// leave a channel just above 1.
float4 source(float2 uv)
{
	float4 c = image.Sample(textureSampler, uv);
	c.rgb = saturate(c.rgb * ((c.a > 0.0) ? (1.0 / c.a) : 0.0));
	return c;
}

float3 invert(float3 rgb)
{
	float hi = max(rgb.r, max(rgb.g, rgb.b));
	float lo = min(rgb.r, min(rgb.g, rgb.b));
	return (keep_hue > 0.5) ? rgb + (1.0 - hi - lo) : 1.0 - rgb;
}

float brightness(float3 rgb)
{
	return max(rgb.r, max(rgb.g, rgb.b));
}

float luma(float3 rgb)
{
	return dot(rgb, float3(0.299, 0.587, 0.114));
}

float maxdiff(float3 a, float3 b)
{
	float3 d = abs(a - b);
	return max(d.r, max(d.g, d.b));
}

// Offset k (0..7) of the ring of radius r: the 8 compass points, rounded.
float2 ring_offset(int k, float r)
{
	float t = float(k) * 0.7853982;
	return float2(floor(r * cos(t) + 0.5), floor(r * sin(t) + 0.5));
}

// ------------------------------------------------------------------ copy --

float4 PSCopy(VertData v_in) : TARGET
{
	return image.Sample(textureSampler, v_in.uv);
}

// ----------------------------------------------------------------- paper --
// One pixel: the paper colour, from 24 small patches along the border. The
// patch that most others agree with (within 0.06), averaged with them; used
// only if at least 60% of the border agrees, is opaque and is light.

float4 patch_at(int k)
{
	int side = k / 6;
	float t = 0.05 + 0.18 * float(k - side * 6);
	float2 size = 1.0 / texel;
	float2 px;
	if (side == 0)
		px = float2(floor(t * size.x), 2.0);
	else if (side == 1)
		px = float2(floor(t * size.x), size.y - 3.0);
	else if (side == 2)
		px = float2(2.0, floor(t * size.y));
	else
		px = float2(size.x - 3.0, floor(t * size.y));
	float4 sum = float4(0.0, 0.0, 0.0, 0.0);
	for (int dy = -1; dy <= 1; dy++) {
		for (int dx = -1; dx <= 1; dx++) {
			float2 q = clamp(px + float2(float(dx), float(dy)), float2(0.0, 0.0), size - 1.0);
			sum += source((q + 0.5) * texel);
		}
	}
	return sum / 9.0;
}

float4 PSPaper(VertData v_in) : TARGET
{
	int best = 0;
	float best_count = -1.0;
	for (int i = 0; i < 24; i++) {
		float4 pi = patch_at(i);
		float count = 0.0;
		for (int j = 0; j < 24; j++) {
			float4 pj = patch_at(j);
			if (maxdiff(pi.rgb, pj.rgb) < 0.06 && pj.a > 0.5)
				count += 1.0;
		}
		if (count > best_count) {
			best_count = count;
			best = i;
		}
	}
	float4 pb = patch_at(best);
	float3 sum = float3(0.0, 0.0, 0.0);
	float n = 0.0;
	for (int j = 0; j < 24; j++) {
		float4 pj = patch_at(j);
		if (maxdiff(pb.rgb, pj.rgb) < 0.06 && pj.a > 0.5) {
			sum += pj.rgb;
			n += 1.0;
		}
	}
	float3 paper = (n > 0.0) ? sum / n : float3(1.0, 1.0, 1.0);
	bool use = best_count >= 0.6 * 24.0 && pb.a > 0.5 && luma(paper) > 0.75;
	if (paper_pick.a > 0.5)
		return float4(paper_pick.rgb, 1.0);
	return float4(paper, use ? 1.0 : 0.0);
}

// --------------------------------------------------------------- process --
// Paper correction, JPEG colour repair, inversion and clean-up. Writes the
// result premultiplied (as it shows over black). For the alpha pass it also
// writes, in alpha, the largest one-pixel step of brightness around the pixel,
// plus 2 if the pixel is flat (part of a plateau).

float3 paper_correct(float3 rgb, float4 paper)
{
	if (paper.a < 0.5 || black_point <= 0.0)
		return rgb;
	float w = saturate(1.0 - maxdiff(rgb, paper.rgb) / 0.3);
	return lerp(rgb, saturate(rgb / max(paper.rgb, float3(0.001, 0.001, 0.001))), w);
}

// The faintest a solid part can be: below it, flat areas are paper. JPEG
// clean-up above it removes only specks.
float solid_floor()
{
	return min(black_point, 0.08);
}

// A pixel where two of the logo's colours meet is a blend of them, and keeping
// hue isn't linear for such a blend: inverting it as one colour gives a fringe
// of the wrong colour along the seam. JPEG makes it worse, since it keeps
// colour at half resolution: a seam's pixels lose their colour, and a dull
// dark one inverts to near white. So find the two colours the pixel lies
// between (the neighbour farthest from it, then the one farthest from that;
// each then averaged over the neighbours like it, to cancel JPEG noise), place
// the pixel between them by luma (which JPEG keeps sharp and accurate) and
// blend their inversions. Chroma only checks it is such a blend at all: a
// third colour isn't. A blend with paper needs nothing (inversion is linear
// for those), so a pixel that is a neighbour's colour part-way to paper is
// left alone: edges against the background don't change.
float3 invert_blend(float2 uv, float4 s, float4 paper)
{
	float3 a = s.rgb;
	float da = 0.0;
	float off_paper = 1.0e9;  // how far the pixel is from any neighbour-paper blend
	float3 ds = float3(1.0, 1.0, 1.0) - s.rgb;
	for (int dy = -2; dy <= 2; dy++) {
		for (int dx = -2; dx <= 2; dx++) {
			float4 n = source(uv + float2(float(dx), float(dy)) * texel);
			float3 rgb = paper_correct(n.rgb, paper);
			float3 e = rgb - s.rgb;
			float3 dn = float3(1.0, 1.0, 1.0) - rgb;
			float tn = dot(ds, dn) / max(dot(dn, dn), 1.0e-4);
			float3 offn = ds - saturate(tn) * dn;
			if (dot(dn, dn) > 0.01 && tn > 0.0 && tn < 0.9)
				off_paper = min(off_paper, sqrt(dot(offn, offn)));
			if (n.a > 0.99 && dot(e, e) > da) {
				da = dot(e, e);
				a = rgb;
			}
		}
	}
	float3 b = a;
	float db = 0.0;
	for (int dy2 = -2; dy2 <= 2; dy2++) {
		for (int dx2 = -2; dx2 <= 2; dx2++) {
			float4 n = source(uv + float2(float(dx2), float(dy2)) * texel);
			float3 rgb = paper_correct(n.rgb, paper);
			float3 e = rgb - a;
			if (n.a > 0.99 && dot(e, e) > db) {
				db = dot(e, e);
				b = rgb;
			}
		}
	}
	float3 plain = invert(s.rgb);
	float ya = luma(a);
	float yb = luma(b);
	if (s.a < 0.99 || abs(yb - ya) < 0.08)
		return plain;
	// Each side's colour: the mean of the neighbours within a quarter of the
	// luma step of it.
	float near_step = 0.25 * abs(yb - ya);
	float4 sum_a = float4(0.0, 0.0, 0.0, 0.0);
	float4 sum_b = float4(0.0, 0.0, 0.0, 0.0);
	for (int dy3 = -2; dy3 <= 2; dy3++) {
		for (int dx3 = -2; dx3 <= 2; dx3++) {
			float3 rgb = paper_correct(source(uv + float2(float(dx3), float(dy3)) * texel).rgb, paper);
			float y = luma(rgb);
			if (abs(y - ya) < near_step)
				sum_a += float4(rgb, 1.0);
			if (abs(y - yb) < near_step)
				sum_b += float4(rgb, 1.0);
		}
	}
	a = sum_a.rgb / max(sum_a.a, 1.0);
	b = sum_b.rgb / max(sum_b.a, 1.0);
	ya = luma(a);
	yb = luma(b);
	if (abs(yb - ya) < 0.08)
		return plain;
	float t = saturate((luma(s.rgb) - ya) / (yb - ya));
	float3 off = s.rgb - lerp(a, b, t);
	float w = saturate(1.0 - sqrt(dot(off, off)) / 0.2) * saturate((off_paper - 0.02) / 0.04);
	return lerp(plain, lerp(invert(a), invert(b), t), w);
}

float4 process(float2 uv, bool flags)
{
	float4 paper = paper_tex.Sample(textureSampler, float2(0.5, 0.5));
	float4 s = source(uv);
	s.rgb = paper_correct(s.rgb, paper);
	bool clean_up = black_point > 0.0;

	float v0 = brightness(invert(s.rgb)) * s.a;  // before repair
	float y0 = luma(s.rgb);
	float near1 = 0.0;
	float lo3 = 1.0e9;
	float hi3 = -1.0e9;
	float step1 = 0.0;
	float2 chroma_sum = float2(0.0, 0.0);
	float chroma_weight = 0.0;
	float luma_sum = 0.0;
	float luma_weight = 0.0;
	if (clean_up || flags) {
		for (int dy = -2; dy <= 2; dy++) {
			for (int dx = -2; dx <= 2; dx++) {
				float4 n = source(uv + float2(float(dx), float(dy)) * texel);
				n.rgb = paper_correct(n.rgb, paper);
				float nv = brightness(invert(n.rgb)) * n.a;
				if (abs(dx) <= 1 && abs(dy) <= 1) {
					near1 = max(near1, nv);
					lo3 = min(lo3, nv);
					hi3 = max(hi3, nv);
					if (abs(dx) + abs(dy) == 1)
						step1 = max(step1, abs(nv - v0));
				}
				float yn = luma(n.rgb);
				float near_weight = exp(-float(dx * dx + dy * dy) / 4.5) * n.a;
				float wc = near_weight * exp(-((yn - y0) * (yn - y0)) / (0.04 * 0.04));
				float wy = near_weight * exp(-((yn - y0) * (yn - y0)) / (0.03 * 0.03));
				chroma_sum += wc * float2(n.b - yn, n.r - yn);
				chroma_weight += wc;
				luma_sum += wy * yn;
				luma_weight += wy;
			}
		}
	}
	if (clean_up && chroma_weight > 0.0 && luma_weight > 0.0) {
		float y = luma_sum / luma_weight;
		float2 cbcr = chroma_sum / chroma_weight;
		float r = y + cbcr.y;
		float b = y + cbcr.x;
		s.rgb = saturate(float3(r, (y - 0.299 * r - 0.114 * b) / 0.587, b));
	}

	float3 c = invert_blend(uv, s, paper);
	float v = brightness(c);
	if (clean_up) {
		// Clean-up above the floor removes specks, not parts: a pixel by (or in)
		// an area of eight or more pixels about as bright as its brightest
		// neighbour is cleaned only as much as at the floor.
		float keep = max(saturate((v - black_point) / black_point),
				 saturate((near1 - black_point) / black_point));
		float f = solid_floor();
		if (black_point > f && near1 > f) {
			float similar = 0.0;
			for (int dy2 = -2; dy2 <= 2; dy2++) {
				for (int dx2 = -2; dx2 <= 2; dx2++) {
					float4 n = source(uv + float2(float(dx2), float(dy2)) * texel);
					n.rgb = paper_correct(n.rgb, paper);
					float nv = brightness(invert(n.rgb)) * n.a;
					similar += (abs(nv - near1) <= 0.03 + 0.1 * near1) ? 1.0 : 0.0;
				}
			}
			if (similar >= 8.0)
				keep = max(saturate((v - f) / f), saturate((near1 - f) / f));
		}
		c *= keep;
		v *= keep;
	}
	float3 p = c * s.a;
	if (!flags)
		return float4(p, s.a);

	// Flat: a plateau of the logo, not a slope or an edge. 3 x 3 range small;
	// for dark greys (which shadows are, once inverted) also the ring of
	// radius 4, so a shadow's gentle slope doesn't pass for a plateau.
	float vv = v * s.a;
	bool is_flat = (hi3 - lo3) <= 0.03 + 0.08 * vv && vv > solid_floor();
	float saturation = (v > 0.0) ? 1.0 - min(c.r, min(c.g, c.b)) / v : 0.0;
	if (is_flat && grey_shadows > 0.5 && saturation < 0.5 && vv < 0.5) {
		float lo4 = v0;
		float hi4 = v0;
		for (int k = 0; k < 8; k++) {
			float4 n = source(uv + ring_offset(k, 4.0 * reach) * texel);
			n.rgb = paper_correct(n.rgb, paper);
			float nv = brightness(invert(n.rgb)) * n.a;
			lo4 = min(lo4, nv);
			hi4 = max(hi4, nv);
		}
		is_flat = (hi4 - lo4) <= 0.03 + 0.08 * vv;
	}
	return float4(p, step1 + (is_flat ? 2.0 : 0.0));
}

float4 PSProcess(VertData v_in) : TARGET
{
	return process(v_in.uv, true);
}

float4 PSProcessOpaque(VertData v_in) : TARGET
{
	return process(v_in.uv, false);
}

// ----------------------------------------------------------------- alpha --
// From the processed image: each pixel's alpha is its brightness over G, the
// brightness of the part it shows at full strength.

// n's brightness if it is a plateau of this pixel's colour at least as
// bright as it, otherwise -1.
float plateau_of(float4 n, float vv, float3 chroma)
{
	float nv = brightness(n.rgb);
	float3 nchroma = (nv > 0.001) ? n.rgb / nv : float3(0.0, 0.0, 0.0);
	if (n.a >= 1.5 && maxdiff(nchroma, chroma) < 0.15 && nv >= vv - 0.000001)
		return nv;
	return -1.0;
}

float4 PSAlpha(VertData v_in) : TARGET
{
	float4 t = image.Sample(textureSampler, v_in.uv);
	float3 p = t.rgb;
	float vv = brightness(p);
	if (vv <= 0.0)
		return float4(0.0, 0.0, 0.0, 0.0);
	float3 chroma = (vv > 0.001) ? p / vv : float3(0.0, 0.0, 0.0);
	float dark_limit = vv + 0.15 + 0.8 * vv;

	float near2 = 0.0;
	float d = 1.0e9;
	float step2 = 0.0;
	float g = -1.0;
	float g_any = 0.0;
	float support = 0.0;
	for (int dy = -2; dy <= 2; dy++) {
		for (int dx = -2; dx <= 2; dx++) {
			float4 n = image.Sample(textureSampler, v_in.uv + float2(float(dx), float(dy)) * reach * texel);
			float nv = brightness(n.rgb);
			bool nflat = n.a >= 1.5;
			near2 = max(near2, nv);
			d = min(d, nv);
			step2 = max(step2, n.a - (nflat ? 2.0 : 0.0));
			g = max(g, plateau_of(n, vv, chroma));
			if (nflat) {
				g_any = max(g_any, nv);
				if (nv <= dark_limit)
					support += 0.04;
			}
		}
	}
	for (int k = 0; k < 8; k++) {
		float4 n4 = image.Sample(textureSampler, v_in.uv + ring_offset(k, 4.0 * reach) * texel);
		g = max(g, plateau_of(n4, vv, chroma));
		if (n4.a >= 1.5 && brightness(n4.rgb) <= dark_limit)
			support += 0.0625;
		float4 n8 = image.Sample(textureSampler, v_in.uv + ring_offset(k, 8.0 * reach) * texel);
		g = max(g, plateau_of(n8, vv, chroma));
	}

	// No plateau of this colour nearby: a crisp feature reaches full strength
	// at its brightest pixel, a blurred one (or a shadow) never does.
	float sharp = saturate((step2 / max(near2, 0.001) - 0.45) / 0.3);
	// Taken as solid, a thin feature that is dark once inverted becomes an
	// opaque dark stroke over the visuals if it was really a faint one; taken
	// as faint when it was solid, it only goes a little see-through. So the
	// darker it is, the more it needs to be crisp to count as solid.
	sharp *= saturate(near2 / 0.3);
	// The tech's call on thin features: faint (0) or solid (1); 0.5 leaves it to the test.
	sharp = saturate(sharp + (detail - 0.5) * 2.0);
	if (g < 0.0)
		g = near2 * sharp + (1.0 - sharp);
	if (g_any <= 0.0)
		g_any = 1.0;

	float bg = max(solid_floor(), 0.02);
	bool edge = d <= bg;
	float a_dark = edge ? 0.0 : ((support >= 0.1) ? 1.0 : d);
	float gs = edge ? g : g_any;
	float tt = saturate((vv - d) / max(gs - d, 0.0001));
	float a = min(max(a_dark + (1.0 - a_dark) * tt, vv), 1.0);

	// With less fade, towards solid: only edges against the background blend.
	float a_solid = edge ? min(max(saturate(vv / max(near2, 0.0001)), vv), 1.0) : 1.0;
	a = lerp(a_solid, a, fade);
	return float4(p, a);
}

technique Copy
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCopy(v_in);
	}
}

technique Paper
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSPaper(v_in);
	}
}

technique Process
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSProcess(v_in);
	}
}

technique ProcessOpaque
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSProcessOpaque(v_in);
	}
}

technique Alpha
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAlpha(v_in);
	}
}

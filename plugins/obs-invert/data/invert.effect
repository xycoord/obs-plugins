// Invert: swaps light and dark, keeping each colour's hue.
//
// Each colour's tone (CIELAB L*, its perceived lightness, which depends only
// on luminance) becomes 1 - L*, and its OKLab hue and chroma are kept. That
// is how Google's HCT makes dark themes: tone differences are what contrast
// is, so every pair of neighbouring colours stands out from each other
// exactly as much after as before, and a logo made for white paper reads the
// same on black. A light, vivid colour may have no dark version as colourful
// (no dark yellow is as colourful as yellow): it keeps its tone and hue and
// loses chroma.
//
// The inversion itself is worked out once, on the CPU, into a 3D lookup table
// indexed by sRGB-encoded colour (see invert-filter.c); this looks colours up
// in it. OBS hands the effect premultiplied colour (in 16-bit float); dividing
// out alpha gives each pixel's colour at full strength, so a source's own
// transparency is kept and its edges against it stay exact.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture3d lut;     // sRGB-encoded colour -> sRGB-encoded inverse
uniform float3 lut_scale;  // encoded colour -> texture coordinate: centres of the end texels
uniform float3 lut_offset;
uniform float hdr;         // 1: an HDR space (linear, may exceed 1), 0: SDR
uniform float multiplier;  // HDR input * multiplier has 1.0 at SDR white (scRGB: 80 nits / SDR white)

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
	AddressW = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

float to_srgb(float u)
{
	return (u <= 0.0031308) ? (12.92 * u) : ((1.055 * pow(u, 1.0 / 2.4)) - 0.055);
}

float from_srgb(float u)
{
	return (u <= 0.04045) ? (u / 12.92) : pow((u + 0.055) / 1.055, 2.4);
}

float3 to_srgb3(float3 u)
{
	return float3(to_srgb(u.r), to_srgb(u.g), to_srgb(u.b));
}

float3 from_srgb3(float3 u)
{
	return float3(from_srgb(u.r), from_srgb(u.g), from_srgb(u.b));
}

float3 invert(float3 encoded)
{
	return lut.Sample(textureSampler, saturate(encoded) * lut_scale + lut_offset).rgb;
}

float4 PSInvert(VertData v_in) : TARGET
{
	float4 c = image.Sample(textureSampler, v_in.uv);
	if (c.a <= 0.0)
		return float4(0.0, 0.0, 0.0, 0.0);
	if (hdr < 0.5) {
		// SDR: OBS keeps colour premultiplied in sRGB-encoded values (and
		// hands an sRGB-aware filter their decode), so re-encode, divide out
		// alpha, invert, and premultiply the same way.
		float3 inverse = invert(to_srgb3(max(c.rgb, 0.0)) / c.a);
		return float4(from_srgb3(inverse * c.a), c.a);
	}
	// HDR: linear and premultiplied in linear light. Anything past SDR white
	// is past paper white, and inverts to black.
	float3 lin = saturate(c.rgb / c.a * multiplier);
	return float4(from_srgb3(invert(to_srgb3(lin))) / multiplier * c.a, c.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSInvert(v_in);
	}
}
